{
  "schema_version": "sireto-retrieval-all-human-v11-config-1",
  "policy_id": "retrieval-v11-all-human-exact-primary",
  "folds": {
    "train": [2, 3, 4],
    "development_diagnostic": 0,
    "test_locked": 1
  },
  "labels": {
    "exact_target_field": "human_ground_truth_siret",
    "precedence": [
      "ground_truth_siret",
      "historical_ground_truth_siret"
    ],
    "valid_siret_pattern": "^[0-9]{14}$",
    "only_exclusion": "NO_VALID_CURRENT_OR_HISTORICAL_HUMAN_SIRET",
    "qualification_fields_may_filter_primary_population": false,
    "operational_labels_separate_from_exact_benchmark": true
  },
  "retrieval": {
    "raw_reference_cap": 10000,
    "maximum_internal_candidates": 2000,
    "maximum_final_candidates": 100,
    "parent_candidate_budget": 700,
    "parent_siren_limit": 64,
    "relation_seed_limit": 32,
    "anchor_protection_slots": 20,
    "consensus_protection_slots": 20,
    "maximum_final_sites_per_siren": 3,
    "conditional_contrastive_rescue": {
      "enabled": true,
      "maximum_executions_per_query": 1,
      "condition": "SPARSE_PARENT_SUPPORT_INSUFFICIENT",
      "unconditional_execution": false
