      "union_head": 96,
      "channel_head": 2,
      "retain_natural_positive_if_present": true,
      "validation_sampling": false
    },
    "xgboost": {
      "parent": {
        "objective": "rank:ndcg",
        "eval_metric": "ndcg@100",
        "tree_method": "hist",
        "n_estimators": 180,
        "learning_rate": 0.04,
        "max_depth": 4,
        "min_child_weight": 25.0,
        "subsample": 1.0,
        "colsample_bytree": 0.85,
        "reg_alpha": 1.0,
        "reg_lambda": 75.0,
        "random_state": 20260831,
        "n_jobs": 0,
        "lambdarank_pair_method": "topk",
        "lambdarank_num_pair_per_sample": 64
      },
      "siret": {
        "objective": "rank:ndcg",
        "eval_metric": "ndcg@100",
        "tree_method": "hist",
        "n_estimators": 180,
        "learning_rate": 0.04,
        "max_depth": 4,
        "min_child_weight": 25.0,
        "subsample": 1.0,
        "colsample_bytree": 0.85,
        "reg_alpha": 1.0,
        "reg_lambda": 75.0,
        "random_state": 20260901,
        "n_jobs": 0,
        "lambdarank_pair_method": "topk",
        "lambdarank_num_pair_per_sample": 64
      }
    }
