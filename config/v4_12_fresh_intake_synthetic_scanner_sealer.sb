(version 1)
(deny default)

(deny network*)
(deny process-fork)
(deny mach-lookup
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.securityd")
  (global-name "com.apple.trustd.agent")
  (global-name "com.apple.LocalAuthentication.UIAgent")
)

; Execute the copied Python.app helper directly.  The Homebrew bin/python3.14
; stub is intentionally absent because it would fork this helper.
(allow process-exec
  (literal "@@PRIVATE_RUNTIME_ROOT@@/rootfs/opt/homebrew/Cellar/python@3.14/3.14.3_1/Frameworks/Python.framework/Versions/3.14/Resources/Python.app/Contents/MacOS/Python")
)

(allow file-read*
  ; dyld requires data access to the root vnode.  This is deliberately a
  ; literal, never a subpath rule.
  (literal "/")
  (subpath "/System")
  (subpath "/usr/lib")
  ; The sole application dependency outside the private runtime.
  (literal "@@HOST_PYTHON_FRAMEWORK@@")
  (literal "/dev/null")
  (literal "/dev/urandom")
  (literal "/dev/fd")
  (subpath "/dev/fd")
  (literal "@@PRIVATE_RUNTIME_ROOT@@")
  (subpath "@@PRIVATE_RUNTIME_ROOT@@")
  (literal "@@SEALED_RUN_ROOT@@")
  (subpath "@@SEALED_RUN_ROOT@@")
  (literal "@@SCAN_RUN_ROOT@@")
  (subpath "@@SCAN_RUN_ROOT@@")
  (literal "@@QUARANTINE_RUN_ROOT@@")
  (subpath "@@QUARANTINE_RUN_ROOT@@")
  (literal "@@WORKER_AUDIT_ROOT@@")
  (subpath "@@WORKER_AUDIT_ROOT@@")
  (literal "@@TMP_RUN_ROOT@@")
  (subpath "@@TMP_RUN_ROOT@@")
)

(allow file-read-metadata
  (literal "/")
  (literal "/Volumes")
  (literal "/Volumes/CATNAT_DATA")
  (literal "/Volumes/CATNAT_DATA/SIRETO_RECALL100")
  (literal "/opt")
  (literal "/opt/homebrew")
  (literal "/opt/homebrew/Cellar")
  (literal "/opt/homebrew/Cellar/python@3.14")
  (literal "/opt/homebrew/Cellar/python@3.14/3.14.3_1")
  (literal "/opt/homebrew/Cellar/python@3.14/3.14.3_1/Frameworks")
  (literal "/opt/homebrew/Cellar/python@3.14/3.14.3_1/Frameworks/Python.framework")
  (literal "/opt/homebrew/Cellar/python@3.14/3.14.3_1/Frameworks/Python.framework/Versions")
  (literal "/opt/homebrew/Cellar/python@3.14/3.14.3_1/Frameworks/Python.framework/Versions/3.14")
  (literal "@@ALLOWED_ROOT@@")
  (literal "@@ALLOWED_ROOT@@/runtime")
  (literal "@@ALLOWED_ROOT@@/sealed")
  (literal "@@ALLOWED_ROOT@@/scan")
  (literal "@@ALLOWED_ROOT@@/quarantine")
  (literal "@@ALLOWED_ROOT@@/audit")
  (literal "@@ALLOWED_ROOT@@/tmp")
)

(allow file-write*
  (literal "@@SEALED_RUN_ROOT@@")
  (subpath "@@SEALED_RUN_ROOT@@")
  (literal "@@SCAN_RUN_ROOT@@")
  (subpath "@@SCAN_RUN_ROOT@@")
  (literal "@@QUARANTINE_RUN_ROOT@@")
  (subpath "@@QUARANTINE_RUN_ROOT@@")
  (literal "@@WORKER_AUDIT_ROOT@@")
  (subpath "@@WORKER_AUDIT_ROOT@@")
  (literal "@@TMP_RUN_ROOT@@")
  (subpath "@@TMP_RUN_ROOT@@")
)

(allow sysctl-read)
